# Copy to .env and fill in locally. NEVER commit real values.
# Used only by the Foundry deploy script (forge script ... --rpc-url ...).
#
# Ethereum Sepolia is our deployment + manual-verification target.
SEPOLIA_RPC_URL=
# Optional: only if you separately deploy the same contract on Base Sepolia.
BASE_SEPOLIA_RPC_URL=

# Deployer private key (0x-prefixed). Use a throwaway test key only.
PRIVATE_KEY=
